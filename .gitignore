# secrets, never commit
.env
.env.local
.env.*.local

# deps + build output
node_modules/
dist/
web/dist/
*.tsbuildinfo

# The live database. Committing this would publish everyone's runs and then fight the
# server for the file on every deploy.
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/

# Intermediate build inputs, all regenerable and none of them small:
#   raw/   the 186MB Wiktionary extraction and the source vocabulary tables
#   cache/ one XML response per word, 6,153 files and 44MB, a cache by definition
#   audio/ the loose clips, which ship as assets/audio.pack instead
# What ships is the OUTPUT: data/words.json and assets/audio.pack.
data/raw/
data/cache/
data/audio/

# Sample clips for the voice comparison page, regenerated by npm run tts:sample
design/samples/

# scratch
*.log
.DS_Store
Thumbs.db
